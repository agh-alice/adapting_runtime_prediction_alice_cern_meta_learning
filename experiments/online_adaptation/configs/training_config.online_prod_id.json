{
  "data_path": "XXX",
  "considered_columns_config_path": "considered_columns_config.json",
  "ohe_threshold_config_path": "ohe_threshold_config.json",
  "filter_data_config_path": "filter_data_config.json",
  "processing_target": "MLP_EMBEDINGS",
  "embeding_reduction_const": 10,
  "multiprocessing_distributed": false,
  "verbose": true,
  "workers": 4,
  "seed": 42,
  "model_name": "ALIPROD_REPTILE_ONLINE_ADAPT_SHARED",
  "batch_size": 512,
  "epochs": 30,
  "evaluation_frequency": 1,
  "checkpoint_frequency": 5,

  "train_valid_split": 0.5,
  "shuffle_before_split": false,
  "shuffle_after_split": false,
  "distinct_split_column": "lpmjobtypeid",
  "sub_valid_splits": null,

  "learning_rate": 0.001,
  "optimizer": "adam",
  "scheduler": "cosine",
  "loss": "huber",
  "metrics": ["mae", "rmse", "mape", "uep", "smape"],

  "inner_lr": 0.02,
  "inner_steps": 4,
  "meta_step_size": 0.005,
  "rel_lambda": 0.1,
  "huber_delta_log": 0.5,
  "max_target": 24.0,
  "embedding_dropout": 0.05,
  "hidden_dropouts": [0.10, 0.10, 0.05, 0.05],
  "weight_decay": 1e-5,

  "online_adaptation_enabled": true,
  "online_min_support": 4,
  "online_max_support": 100,
  "online_inner_steps": 2,
  "online_inner_lr": 0.02
}
